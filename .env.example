# Antibody — env template. Copy to .env and fill in. NEVER commit .env.

# Hindsight Cloud (managed) — https://api.hindsight.vectorize.io , path prefix /v1/default
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=hsk_xxx_your_key_here

# Bank ids
HINDSIGHT_TRAFFIC_BANK=antibody-traffic
HINDSIGHT_ANTIGEN_BANK=antibody-antigens
HINDSIGHT_DREAM_BANK=antibody-dream

# Groq
GROQ_API_KEY=gsk_xxx_your_key_here
GROQ_API_KEY_BACKUP=gsk_xxx_second_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_FALLBACK=qwen/qwen3-32b

# App
IDENTITY_SALT=change-me-random-salt
